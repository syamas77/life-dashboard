#!/bin/sh
# Gmail MCP starts both stdio and an HTTP listener; keep its optional HTTP port
# away from the Life Dashboard frontend while using stdio through the gateway.
export PORT="${PORT:-45877}"
export TELEMETRY_ENABLED="false"
NPX_BIN=$(command -v npx) || { echo "npx is required for Gmail MCP" >&2; exit 1; }
exec "$NPX_BIN" -y @shinzolabs/gmail-mcp "$@"
