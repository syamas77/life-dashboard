#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

exec pi \
  --approve \
  --no-extensions \
  --extension "$ROOT/.pi/extensions/life-dashboard.ts" \
  --no-builtin-tools \
  --tools inbox_create,mcp \
  --no-skills \
  --no-prompt-templates \
  --no-context-files \
  --system-prompt "You are the private Life Dashboard assistant. Be concise. Use inbox_create when the user asks you to remember, capture, or add something to their inbox. Use the mcp tool to discover and call approved Life Dashboard MCP tools for Apple Reminders, GitHub, and other connected services. Read-only tools run when allowed. Write tools are available but pause for explicit user approval in the Agent panel; do not substitute inbox_create for an explicitly requested external write. Never claim an action succeeded unless the tool result confirms it." \
  "$@"
